@startuml documents_model_v8
title Documents — Django domain model v8\nv7 + information-origin dating: EDTF truth, derived bounds, source + confidence (Dated mixin)

hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam wrapWidth 270

legend right
  **UML → Django mapping**
  filled diamond .... FK on_delete=CASCADE
  solid arrow ....... FK on_delete=PROTECT
  dashed arrow ...... FK on_delete=SET_NULL, null=True
  hollow triangle ... abstract base model (abstract=True)
  package ........... aggregate: swaps as one unit
  --
  Offsets: GLOBAL slices of immutable strings.
  Coordinates: normalized [0,1], top-left origin.
  conf_stats {n,sum,min,max,hist[10]}: additive.
  Dates: date_edtf (EDTF/ISO 8601-2) is the
  truth; date_min/date_max are derived strict
  bounds — a NULL bound = open on that side.
endlegend

enum ExtractionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum StructureSource {
  EMBEDDED
  DETECTED
  CURATED
}

enum DateSource {
  EXPLICIT
  METADATA
  INFERRED
  INTERPOLATED
  INHERITED
  AGGREGATED
  CURATED
}

abstract class Dated <<abstract mixin>> {
  date_edtf : CharField(64) (null)
  date_min : DateField (null)
  date_max : DateField (null)
  date_source : DateSource (null)
  date_conf : FloatField (null)
  .. constraints ..
  check: date_min <= date_max (when both set)
  .. api ..
  {static} objects.overlapping(period)
}

class Blob <<Model>> {
  id : UUIDField <<PK>>
  sha256 : CharField(64)
  size : BigIntegerField
  mime_type : CharField(100)
  file : FileField
  created_at : DateTimeField
  .. constraints ..
  unique: sha256
  .. semantics ..
  immutable, content-addressed;
  originals AND derived artifacts
}

class Document <<Model>> {
  id : UUIDField <<PK>>
  title : CharField(500)
  meta : JSONField
  created_at : DateTimeField
  .. facade — the public interface ..
  text : str
  html : str
  pages : QuerySet[Page]
  outline() : list[Node]
  hit(page_no, x, y) : Node
  confidence(measure) : float | Histogram
  date : UncertainDate
  timeline() : QuerySet[Node]
  reextract(extractor) : DocumentContent
  .. invariants ..
  clean(): current_content.is_current
  and current_content.document == self
}

class Extractor <<Model>> {
  id : BigAutoField <<PK>>
  name : CharField(100)
  version : CharField(50)
  config : JSONField
  .. constraints ..
  unique: (name, version)
}

package "Immutable content snapshot" #FBF9F4 {

  class DocumentContent <<Model>> {
    id : UUIDField <<PK>>
    status : ExtractionStatus = PENDING
    is_current : BooleanField = False
    html : TextField
    text : TextField
    conf_stats : JSONField (null)
    stats : JSONField
    error : TextField
    started_at : DateTimeField (null)
    finished_at : DateTimeField (null)
    created_at : DateTimeField
    .. constraints ..
    partial unique: (document) where is_current
    partial index: (date_min, date_max)
    where is_current
    FTS index on text
    .. api ..
    outline() : list[Node]
    node(nid) : Node
    diff(other : DocumentContent) : ContentDiff
    .. managers ..
    successful(): filter(status=SUCCEEDED)
  }

  class Page <<Model>> {
    number : PositiveIntegerField
    label : CharField(20) (null)
    width : FloatField (null)
    height : FloatField (null)
    conf_stats : JSONField (null)
    meta : JSONField
    .. constraints ..
    unique: (content, number)
    index: (content, date_min)
    .. api ..
    reduced_html() : str
    text() : str
    hit(x, y) : Node
  }

  class Node <<Model>> {
    nid : PositiveIntegerField
    path : CharField(255)
    order : PositiveIntegerField
    tag : CharField(20)
    level : PositiveSmallIntegerField (null)
    title : CharField(1000) (null)
    source : StructureSource
    conf_stats : JSONField (null)
    html_start : IntegerField
    html_end : IntegerField
    text_start : IntegerField
    text_end : IntegerField
    .. constraints ..
    unique: (content, nid)
    index: (content, path)
    index: (content, text_start)
    index: (content, tag)
    index: (content, date_min)
    .. api ..
    html() : str
    text() : str
    subtree() : QuerySet[Node]
    regions() : list[(Page, polygon | envelope)]
    conf(measure) : float | Histogram
  }

  class PageRegion <<Model>> {
    x0, y0, x1, y1 : FloatField
    polygon : JSONField (null)
    words : JSONField (null)
    conf_stats : JSONField (null)
    detect_conf : FloatField (null)
    order : PositiveIntegerField
    text_start : IntegerField (null)
    text_end : IntegerField (null)
    .. constraints ..
    index: (page)
    index: (node)
    .. semantics ..
    x0..y1 = envelope, derived from polygon
  }
}

