"""Business logic for ${name}. Plain typed Python; no request objects, no framework glue.

Every function takes the acting `user`; reads go through `${Model}.objects.for_user(user)`.
"""

from django.db.models import QuerySet

from apps.accounts.models import User
from apps.${name}.models import ${Model}, ${Model}Id
from apps.${name}.schemas import ${Model}In, ${Model}Patch


class ${Model}NotFound(Exception):
    pass


def list_${plural}(user: User) -> QuerySet[${Model}]:
    return ${Model}.objects.for_user(user)


def get_${model}(user: User, ${model}_id: ${Model}Id) -> ${Model}:
    try:
        return ${Model}.objects.for_user(user).get(pk=${model}_id)
    except ${Model}.DoesNotExist as exc:
        raise ${Model}NotFound(${model}_id) from exc


def create_${model}(user: User, *, name: str, description: str = "") -> ${Model}:
    return ${Model}.objects.create(owner=user, name=name, description=description)


def update_${model}(user: User, ${model}_id: ${Model}Id, payload: ${Model}In) -> ${Model}:
    ${model} = get_${model}(user, ${model}_id)
    ${model}.set_payload(payload)
    ${model}.save()
    return ${model}


def patch_${model}(user: User, ${model}_id: ${Model}Id, payload: ${Model}Patch) -> ${Model}:
    ${model} = get_${model}(user, ${model}_id)
    ${model}.set_payload_partial(payload)
    ${model}.save()
    return ${model}


def delete_${model}(user: User, ${model}_id: ${Model}Id) -> None:
    deleted, _ = ${Model}.objects.for_user(user).filter(pk=${model}_id).delete()
    if deleted == 0:
        raise ${Model}NotFound(${model}_id)
