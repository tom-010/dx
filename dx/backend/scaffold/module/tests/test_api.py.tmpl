import uuid
from collections.abc import Callable

import pytest
from django.test import Client

from apps.accounts.models import User
from apps.${name} import services
from apps.${name}.models import ${Model}Id

pytestmark = pytest.mark.django_db


def test_create_and_list(auth_client: Client) -> None:
    created = auth_client.post(
        "/api/${name}", {"name": "First", "description": "d"}, content_type="application/json"
    )

    assert created.status_code == 201
    body = created.json()
    assert (body["name"], body["description"]) == ("First", "d")

    listed = auth_client.get("/api/${name}")
    assert listed.status_code == 200
    assert listed.json() == {"items": [body], "count": 1}


def test_get_put_patch_delete(auth_client: Client, user: User) -> None:
    ${model} = services.create_${model}(user, name="Temp", description="d")
    url = f"/api/${name}/{${model}.pk}"

    assert auth_client.get(url).status_code == 200

    replaced = auth_client.put(url, {"name": "Full"}, content_type="application/json")
    assert replaced.status_code == 200
    assert (replaced.json()["name"], replaced.json()["description"]) == ("Full", "")

    patched = auth_client.patch(url, {"description": "x"}, content_type="application/json")
    assert (patched.json()["name"], patched.json()["description"]) == ("Full", "x")

    assert auth_client.delete(url).status_code == 204
    assert auth_client.get(url).json() == {"detail": "${Model} not found"}


def test_other_users_get_404(
    user: User, other_user: User, client_for: Callable[[User], Client]
) -> None:
    ${model} = services.create_${model}(user, name="mine")
    other = client_for(other_user)

    assert other.get("/api/${name}").json() == {"items": [], "count": 0}
    assert other.get(f"/api/${name}/{${model}.pk}").status_code == 404
    assert other.delete(f"/api/${name}/{${model}.pk}").status_code == 404


def test_service_raises_for_unknown_id(user: User) -> None:
    with pytest.raises(services.${Model}NotFound):
        services.get_${model}(user, ${Model}Id(uuid.uuid7()))
