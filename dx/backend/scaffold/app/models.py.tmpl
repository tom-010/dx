import uuid
from typing import NewType

from django.db import models

from apps.core.history import tracked
from apps.core.models import OwnedModel

${Model}Id = NewType("${Model}Id", uuid.UUID)


# Every write is captured in ${Model}Event by a database trigger (apps/core/history.py).
# Removing @tracked means listing the model in HISTORY_EXEMPT with a reason — a test fails
# otherwise. Never use a plain ManyToManyField here: declare an owned `through=` model, or the
# join rows change with no version row behind them.
@tracked
class ${Model}(OwnedModel):
    """TODO: describe what a ${model} is."""

    name = models.CharField(max_length=200)
    description = models.TextField(blank=True)

    class Meta(OwnedModel.Meta):
        pass

    @staticmethod
    def example() -> ${Model}:
        """One filled-in ${model}, unsaved: `save_example(${Model}.example())` writes it.

        Every model has one (apps/core/examples.py, system check example.E001). Fill in every
        required field, build a required foreign key by calling *its* model's `example()`, and
        leave `owner`, `id`, `created`, `modified` and `version` to the tenant context and the
        database. A field under a unique constraint gets `unique("…")`.
        """
        return ${Model}(name="First ${model}", description="TODO: what a real ${model} says.")
