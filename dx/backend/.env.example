# Copy to backend/.env to override defaults (see config/env.py for all keys, docker/.env.prod.example
# for a production set). Lists are JSON.
DEBUG=true
# Refused when DEBUG=false; generate: openssl rand -hex 32. SECRET_KEY_FALLBACKS: old keys while rotating.
SECRET_KEY=django-insecure-dev-only-change-me
SECRET_KEY_FALLBACKS=[]
# Empty + DEBUG = localhost. Production: ["dx.example.com"] (loopback is added for the healthcheck).
ALLOWED_HOSTS=[]
# HTTPS_ONLY unset = not DEBUG: https redirect, secure cookies, HSTS, trust X-Forwarded-Proto.
HTTPS_ONLY=
SECURE_HSTS_SECONDS=3600
# Query parameters become psycopg options (?sslmode=require). DB_CONN_MAX_AGE=0 behind pgbouncer.
# The URL's credentials are the runtime role `app_user` (row-level security applies to it).
DATABASE_URL=postgres://app_user:app_user@localhost:5432/dx
DB_CONN_MAX_AGE=60
# Which credentials this process uses: app (default) | migrator (./scripts/migrate.sh, backups,
# tests) | admin (manage.py shell_admin). Dev migrator = the compose superuser.
DB_ROLE=app
DB_MIGRATOR_USER=dx
DB_MIGRATOR_PASSWORD=dx
# BYPASSRLS role for `manage.py shell_admin`; never set these for the web process or workers.
DB_ADMIN_USER=app_admin
DB_ADMIN_PASSWORD=app_admin
# Django's cache (sessions): Valkey db 1 from docker/docker-compose.yml (Celery uses db 0).
CACHE_URL=redis://localhost:6379/1
FRONTEND_DIST=../frontend/dist
# Logging (config/logging.py): LOG_FORMAT unset = console while DEBUG, json otherwise.
LOG_LEVEL=INFO
LOG_FORMAT=
LOG_SQL=false
# Email: unset = console output. smtp://user:password@host:587?tls=true, smtps://…:465, dummy://
EMAIL_URL=
DEFAULT_FROM_EMAIL=noreply@localhost
# Error monitoring (unset = off); APP_VERSION is the release label (the image sets it).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_VERSION=dev
# Auth (apps.accounts): access JWT lifetime (short, not revocable) and refresh-token lifetime.
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30
# Static bearer token for CI/scripts (acts as the first superuser); generate: openssl rand -hex 32
API_FIXED_TOKEN=
REGISTRATION_OPEN=false
# Only the Capacitor apps are cross-origin (JSON lists)
CORS_ALLOWED_ORIGINS=[]
CSRF_TRUSTED_ORIGINS=[]
# Celery: Valkey from docker/docker-compose.yml. Tasks need a worker (./scripts/celery.sh);
# CELERY_EAGER=true runs them inline in Django instead (no worker, no progress events).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
CELERY_EAGER=false
# File storage: "s3" (default; RustFS from docker/docker-compose.yml, console http://localhost:9101)
# or "local" (backend/media). Leave S3_ENDPOINT_URL empty for real AWS S3.
MEDIA_STORAGE=s3
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=dx
S3_SECRET_KEY=dxdxdxdx
S3_BUCKET=dx-media
S3_REGION=us-east-1
# Database dumps (manage.py backup, nightly Celery beat task): bucket in the same store, or
# backend/backups/ with MEDIA_STORAGE=local. BACKUP_KEEP = dumps the nightly task keeps.
S3_BACKUP_BUCKET=dx-backups
BACKUP_KEEP=30
