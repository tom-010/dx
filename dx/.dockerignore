**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
frontend/dist/
backend/staticfiles/
**/.env
**/.env.*
*.md
.idea/
.vscode/
.DS_Store
**/stats.html
backend/media/
template/
notebooks/
logs/
backend/backups/
**/htmlcov/
**/.coverage
**/coverage.xml
frontend/.tanstack/
.claude/
