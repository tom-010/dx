# Production configuration for docker/docker-compose.prod.yml. Copy to docker/.env.prod
# (git-ignored), fill in, then ./scripts/prod.sh. Every key of backend/config/env.py may be set
# here too (comments only on their own lines). Secrets: openssl rand -hex 32

# Public host name — DNS must point here; Caddy fetches the certificate from Let's Encrypt.
DOMAIN=dx.example.com
# Let's Encrypt account e-mail (certificate expiry warnings).
ACME_EMAIL=admin@example.com

SECRET_KEY=
# Postgres: the bootstrap superuser, and the application roles (docker/postgres/10-roles.sh):
# app_user = the web process/workers (row-level security applies), app_migrator = owns the tables
# (migrations, backups). The third role, app_admin (BYPASSRLS, `manage.py shell_admin`), gets no
# password from this file — it is every service's env_file and the admin credentials must never
# reach app/worker. Set it ad hoc: POSTGRES_ADMIN_PASSWORD=… ./scripts/prod.sh up -d db
# (re-runs the roles script), then use it from an ops shell as DB_ADMIN_USER/DB_ADMIN_PASSWORD.
# PGBOUNCER_PASSWORD is the pooler's lookup role (`pgbouncer`): it can read password secrets
# for the pooler's SCRAM check and nothing else; also the PgBouncer console login.
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
DB_MIGRATOR_PASSWORD=
PGBOUNCER_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Outgoing mail: smtp://user:password@host:587?tls=true, smtps://…:465, or dummy:// (sends nothing).
EMAIL_URL=smtp://user:password@smtp.example.com:587?tls=true
DEFAULT_FROM_EMAIL=dx <noreply@dx.example.com>

# ---- Optional ------------------------------------------------------------------------------
# Image to run (default dx-app:latest — ./scripts/build.sh, or `./scripts/prod.sh up -d --build`).
#IMAGE=ghcr.io/you/dx-app:1.2.3
# Error monitoring.
#SENTRY_DSN=
# Google Gemini (manage.py playground).
#GEMINI_API_KEY=
# HSTS max-age: raise to a year once https is known to work everywhere (browsers remember it).
#SECURE_HSTS_SECONDS=31536000
# Key rotation: previous SECRET_KEY(s) still accepted for sessions and signed links (JSON list).
#SECRET_KEY_FALLBACKS=["previous-key"]
# Self-service sign-up (POST /api/auth/register).
#REGISTRATION_OPEN=false
# JWT lifetimes: access tokens (cannot be revoked — keep short), refresh tokens (= login validity).
#ACCESS_TOKEN_LIFETIME_MINUTES=15
#REFRESH_TOKEN_LIFETIME_DAYS=30
# Capacitor apps (JSON lists).
#CORS_ALLOWED_ORIGINS=["capacitor://localhost","https://localhost"]
#CSRF_TRUSTED_ORIGINS=["capacitor://localhost","https://localhost"]
# Sizing: gunicorn processes × threads, Celery worker processes, PgBouncer (real connections
# to Postgres per pool; client sockets it accepts — the compose file explains the budget).
#WEB_CONCURRENCY=2
#GUNICORN_THREADS=8
#CELERY_CONCURRENCY=2
#PGBOUNCER_POOL_SIZE=20
#PGBOUNCER_MAX_CLIENT_CONN=10000
#LOG_LEVEL=INFO
# Managed services instead of the compose ones (then drop the service from the compose file).
# The database needs the three roles from docker/postgres/10-roles.sh; DATABASE_URL carries the
# app_user credentials, DB_MIGRATOR_USER/DB_MIGRATOR_PASSWORD the table owner's.
# DATABASE_POOL_URL is what the web process connects to: the provider's transaction-mode
# pooler (same database, same credentials), or DB_POOLED=false to go without one.
#DATABASE_URL=postgres://app_user:password@host:5432/dx?sslmode=require
#DATABASE_POOL_URL=postgres://app_user:password@pooler-host:6432/dx?sslmode=require
#DB_POOLED=false
#DB_MIGRATOR_USER=app_migrator
#CACHE_URL=rediss://…/1
#CELERY_BROKER_URL=rediss://…/0
#S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
